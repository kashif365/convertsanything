<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Converted from PDF: sample1.pdf</title><style>
            body{font-family:Calibri,Arial,sans-serif;background:#f3f5f7;margin:0;padding:24px;color:#111}
            .page{position:relative;margin:0 auto 24px;background:#fff;box-shadow:0 8px 24px rgba(15,23,42,.08);overflow:hidden}
            .page-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:fill}
            .page-text{position:absolute;inset:0}
            .text-line{position:absolute;white-space:pre-wrap;line-height:1.15;max-width:95%}
            .text-line-ocr{color:transparent}
            </style></head><body><section class="page" style="width:794px;height:1122px;"><div class="page-text"><div class="text-line" style="left:42px;top:44px;font-size:21px;font-weight:normal;">First sample PDF page</div></div></section></body></html>