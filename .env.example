
APP_NAME=ConvertsAnything
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

FILESYSTEM_DISK=public
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Optional: point the frontend JS to a different backend if you split the app later.
VITE_LARAVEL_API_URL=${APP_URL}/api

# Document tool runtime
PDF_PYTHON_BIN=python
LIBREOFFICE_BIN=
WORD_TO_PDF_TIMEOUT=180
